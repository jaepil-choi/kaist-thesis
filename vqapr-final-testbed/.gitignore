# Everything a run derives, plus the staged inputs. Source, declarations and the control files
# are tracked. `paper/` and `data/` are copies of material that already lives elsewhere in this
# repository; the README says how to restage them.
data/
paper/
workspace/
outputs/
.vqapr/
.venv/
__pycache__/
# uv.lock is tracked: the venv must be reproducible byte-for-byte across runs.
